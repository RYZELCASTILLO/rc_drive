<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin{% endblock %} - RC Drive</title>
    <link rel="icon" href="{{ asset('images/logo.png') }}">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        h1, h2, h3, h4, .dash-btn, .dash-badge, .dash-role-badge, .sidebar-nav a, .stat-label, .stat-value, .brand-name { font-family: 'Montserrat', sans-serif; }
        body { background: #0b0c0e; color: #ffffff; }

        /* ===== LAYOUT ===== */
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-main { margin-left: 260px; flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 100vh; }
        .admin-content { flex: 1; padding: 40px; }

        /* ===== SIDEBAR ===== */
        .sidebar { width: 260px; background: #161a20; border-right: 1px solid #222730; position: fixed; top: 0; left: 0; bottom: 0; display: flex; flex-direction: column; padding: 24px 16px; overflow-y: auto; z-index: 100; }
        .sidebar-logo { padding: 0 8px 24px; border-bottom: 1px solid #222730; margin-bottom: 10px; }
        .sidebar-logo img { height: 50px; width: auto; display: block; }
        .sidebar-label { display: block; font-size: 0.7rem; letter-spacing: 1.5px; text-transform: uppercase; color: #8a8f9d; font-weight: 800; margin: 18px 12px 8px; }
        .sidebar-nav a { display: flex; align-items: center; gap: 12px; padding: 12px 14px; margin-bottom: 4px; border-radius: 4px; border-left: 4px solid transparent; color: #a0a5b1; text-decoration: none; font-size: 0.85rem; font-weight: 700; transition: 0.2s; }
        .sidebar-nav a i { width: 18px; text-align: center; }
        .sidebar-nav a:hover { background: rgba(252, 193, 19, 0.08); color: #ffffff; }
        .sidebar-nav a.active { background: rgba(252, 193, 19, 0.12); color: #FCC113; border-left-color: #FCC113; }
        .sidebar-bottom { margin-top: auto; padding-top: 20px; border-top: 1px solid #222730; font-size: 0.75rem; color: #8a8f9d; }
        .sidebar-bottom i { color: #FCC113; }

        /* ===== TOPBAR & FOOTER ===== */
        .topbar { display: flex; justify-content: space-between; align-items: center; padding: 16px 40px; background: #212529; position: sticky; top: 0; z-index: 50; flex-wrap: wrap; gap: 12px; }
        .topbar-title { font-family: 'Montserrat', sans-serif; font-weight: 800; letter-spacing: 1px; font-size: 0.85rem; color: #a0a5b1; text-transform: uppercase; }
        .topbar-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .admin-footer { padding: 20px 40px; border-top: 1px solid #222730; color: #8a8f9d; font-size: 0.8rem; text-align: center; }

        /* ===== BUTTONS & BADGES ===== */
        .dash-role-badge { background: #dc3545; color: #ffffff; padding: 8px 16px; border-radius: 4px; font-size: 0.75rem; font-weight: 900; letter-spacing: 1px; }
        .dash-btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 18px; border-radius: 4px; font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: 0.2s; }
        .dash-btn-yellow { background: #FCC113; color: #212529; }
        .dash-btn-yellow:hover { background: #e0aa0f; }
        .dash-btn-outline { background: transparent; border-color: #FCC113; color: #FCC113; }
        .dash-btn-outline:hover { background: #FCC113; color: #212529; }
        .dash-btn-danger { background: transparent; border-color: #dc3545; color: #dc3545; }
        .dash-btn-danger:hover { background: #dc3545; color: #ffffff; }

        .dash-badge { display: inline-block; padding: 5px 12px; border-radius: 3px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; white-space: nowrap; }
        .dash-badge-approved  { background: #28a745; color: #ffffff; }
        .dash-badge-pending   { background: #FCC113; color: #212529; }
        .dash-badge-rejected  { background: #dc3545; color: #ffffff; }
        .dash-badge-pickedup  { background: #0dcaf0; color: #0b0c0e; }
        .dash-badge-returned  { background: #17a2b8; color: #ffffff; }
        .dash-badge-cancelreq { background: #fd7e14; color: #ffffff; }
        .dash-badge-cancelled { background: #6c757d; color: #ffffff; }

        /* ===== PAGE TITLE & ALERTS ===== */
        .dash-page-title { margin-bottom: 30px; }
        .dash-page-title h2 { font-size: 1.8rem; font-weight: 800; margin-bottom: 6px; }
        .dash-page-title h2 span { color: #FCC113; }
        .dash-page-title p { color: #8a8f9d; font-size: 0.9rem; }
        .dash-alert { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 4px; margin-bottom: 20px; font-size: 0.9rem; }
        .dash-alert-error { background: rgba(220, 53, 69, 0.1); border-left: 4px solid #dc3545; color: #ff5560; }
        .dash-alert-info  { background: rgba(13, 202, 240, 0.1); border-left: 4px solid #0dcaf0; color: #0dcaf0; }

        /* ===== STAT CARDS ===== */
        .dash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .dash-stat-card { background: #1a1e24; border: 1px solid #2a2f38; border-left: 4px solid #FCC113; border-radius: 4px; padding: 24px; transition: 0.3s; }
        .dash-stat-card:hover { border-color: #FCC113; transform: translateY(-3px); }
        .stat-label { display: block; font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: #8a8f9d; margin-bottom: 10px; }
        .stat-value { font-size: 2.2rem; font-weight: 900; color: #FCC113; line-height: 1.1; }
        .stat-sub { display: block; font-size: 0.8rem; color: #8a8f9d; margin-top: 6px; }
        .dash-stat-card.green { border-left-color: #28a745; }
        .dash-stat-card.green .stat-value { color: #28a745; }
        .dash-stat-card.red { border-left-color: #dc3545; }
        .dash-stat-card.red .stat-value { color: #dc3545; }
        .dash-stat-card.blue { border-left-color: #0dcaf0; }
        .dash-stat-card.blue .stat-value { color: #0dcaf0; }

        /* ===== SECTIONS ===== */
        .dash-section { background: #161a20; border: 1px solid #222730; border-radius: 4px; padding: 30px; margin-bottom: 30px; }
        .dash-section-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; padding-bottom: 16px; border-bottom: 1px solid #222730; flex-wrap: wrap; gap: 12px; }
        .dash-section-title h3 { font-size: 1.15rem; font-weight: 800; display: flex; align-items: center; gap: 10px; }
        .dash-section-title h3 i { color: #FCC113; }
        .title-note { font-size: 0.8rem; color: #8a8f9d; }

        /* ===== BRAND CARDS ===== */
        .brand-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
        .brand-card { background: #1a1e24; border: 1px solid #2a2f38; border-radius: 4px; padding: 24px; transition: 0.3s; }
        .brand-card:hover { border-color: #FCC113; }
        .brand-name { font-size: 1.1rem; font-weight: 800; color: #ffffff; }
        .brand-sub { display: block; font-size: 0.75rem; color: #8a8f9d; margin: 4px 0 14px; }
        .brand-row { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid #2a2f38; font-size: 0.85rem; }
        .brand-row:last-child { border-bottom: none; }
        .brand-row span:first-child { color: #a0a5b1; }
        .brand-row span:last-child { font-weight: 800; }
        .brand-row .available { color: #28a745; }
        .brand-row .rented { color: #FCC113; }

        /* ===== TABLES ===== */
        .dash-table-wrap { overflow-x: auto; }
        .dash-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        .dash-table thead th { text-align: left; font-family: 'Montserrat', sans-serif; font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: #FCC113; padding: 14px 12px; border-bottom: 2px solid #2a2f38; white-space: nowrap; }
        .dash-table tbody td { padding: 16px 12px; border-bottom: 1px solid #222730; color: #d4d8dd; vertical-align: middle; }
        .dash-table tbody tr:hover { background: rgba(252, 193, 19, 0.04); }
        .dash-table .empty-row td { text-align: center; color: #8a8f9d; padding: 40px 12px; font-style: italic; }
        .dash-vehicle-name { color: #FCC113 !important; font-weight: 800; font-family: 'Montserrat', sans-serif; }
        .dash-money { color: #28a745 !important; font-weight: 800; font-family: 'Montserrat', sans-serif; }

        /* ===== BOOKINGS PAGE ===== */
        .dash-alert-success { background: rgba(40, 167, 69, 0.1); border-left: 4px solid #28a745; color: #3ddc6a; }
        .dash-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
        .dash-tab { padding: 8px 16px; border: 1px solid #2a2f38; border-radius: 4px; color: #a0a5b1; text-decoration: none; font-size: 0.8rem; font-weight: 700; font-family: 'Montserrat', sans-serif; transition: 0.2s; }
        .dash-tab:hover { border-color: #FCC113; color: #ffffff; }
        .dash-tab.active { background: #FCC113; border-color: #FCC113; color: #212529; }
        .dash-tab .count { margin-left: 6px; opacity: 0.7; }
        .action-group { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
        .action-group form { display: inline-flex; gap: 6px; align-items: center; margin: 0; }
        .dash-btn-sm { padding: 6px 12px; font-size: 0.7rem; }
        .dash-btn-green { background: transparent; border-color: #28a745; color: #28a745; }
        .dash-btn-green:hover { background: #28a745; color: #ffffff; }
        .late-input { width: 92px; padding: 6px 8px; background: #0b0c0e; border: 1px solid #2a2f38; border-radius: 4px; color: #ffffff; font-size: 0.75rem; }
        .cell-sub { display: block; font-size: 0.75rem; color: #8a8f9d; margin-top: 2px; }
        .dash-badge-paid   { background: #28a745; color: #ffffff; }
        .dash-badge-unpaid { background: #6c757d; color: #ffffff; }
        .dash-badge-partial { background: #0dcaf0; color: #0b0c0e; }
        .dash-badge-verify { background: #fd7e14; color: #ffffff; }

        /* ===== FLEET PAGE ===== */
        .fleet-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
        .fleet-card { background: #1a1e24; border: 1px solid #2a2f38; border-radius: 4px; overflow: hidden; transition: 0.3s; }
        .fleet-card:hover { border-color: #FCC113; }
        .fleet-img { width: 100%; height: 180px; object-fit: cover; display: block; background: #0b0c0e; }
        .fleet-body { padding: 22px; }
        .fleet-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 4px; }
        .fleet-price { color: #FCC113; font-weight: 800; font-family: 'Montserrat', sans-serif; margin: 6px 0 14px; }
        .stock-bar { height: 8px; background: #2a2f38; border-radius: 4px; overflow: hidden; margin: 14px 0 18px; }
        .stock-bar span { display: block; height: 100%; background: #28a745; }

        /* ===== CONVERSATIONS PAGE ===== */
        .chat-layout { display: grid; grid-template-columns: 320px 1fr; gap: 20px; }
        .chat-list { background: #161a20; border: 1px solid #222730; border-radius: 4px; overflow: hidden; align-self: start; }
        .chat-item { display: block; padding: 16px 18px; border-bottom: 1px solid #222730; border-left: 4px solid transparent; text-decoration: none; color: #d4d8dd; transition: 0.2s; }
        .chat-item:last-child { border-bottom: none; }
        .chat-item:hover { background: rgba(252, 193, 19, 0.05); }
        .chat-item.active { background: rgba(252, 193, 19, 0.1); border-left-color: #FCC113; }
        .chat-item .dash-badge { margin-top: 8px; }
        .chat-item-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
        .chat-name { font-weight: 800; font-family: 'Montserrat', sans-serif; font-size: 0.9rem; }
        .chat-subject { font-size: 0.8rem; color: #a0a5b1; margin-top: 4px; }
        .chat-unread { background: #dc3545; color: #ffffff; border-radius: 10px; padding: 2px 8px; font-size: 0.7rem; font-weight: 800; }
        .chat-thread { background: #161a20; border: 1px solid #222730; border-radius: 4px; display: flex; flex-direction: column; }
        .chat-head { display: flex; justify-content: space-between; align-items: center; padding: 18px 22px; border-bottom: 1px solid #222730; gap: 12px; flex-wrap: wrap; }
        .chat-messages { padding: 22px; display: flex; flex-direction: column; gap: 14px; max-height: 440px; overflow-y: auto; }
        .bubble { max-width: 75%; padding: 12px 16px; border-radius: 8px; font-size: 0.9rem; line-height: 1.5; }
        .bubble small { display: block; margin-top: 6px; font-size: 0.7rem; opacity: 0.7; }
        .bubble-customer { align-self: flex-start; background: #1a1e24; border: 1px solid #2a2f38; color: #d4d8dd; }
        .bubble-admin { align-self: flex-end; background: #FCC113; color: #212529; }
        .chat-reply { display: flex; gap: 12px; padding: 18px 22px; border-top: 1px solid #222730; align-items: flex-end; }
        .chat-reply textarea { flex: 1; min-height: 52px; resize: vertical; background: #0b0c0e; border: 1px solid #2a2f38; border-radius: 4px; color: #ffffff; padding: 12px; font-size: 0.9rem; }
        .chat-reply textarea:focus { outline: none; border-color: #FCC113; }
        .chat-closed { padding: 18px 22px; border-top: 1px solid #222730; color: #8a8f9d; font-size: 0.85rem; }
        @media (max-width: 900px) { .chat-layout { grid-template-columns: 1fr; } }
        
        /* ===== SMALL SCREENS: sidebar shrinks to icons ===== */
        @media (max-width: 900px) {
            .sidebar { width: 72px; padding: 20px 8px; }
            .sidebar-logo img { height: 36px; }
            .sidebar .link-text, .sidebar-label { display: none; }
            .sidebar-nav a { justify-content: center; padding: 12px 6px; }
            .admin-main { margin-left: 72px; }
            .admin-content { padding: 24px 16px; }
            .topbar { padding: 14px 16px; }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<div class="admin-layout">
    {% include 'partials/sidebar.html.twig' %}

    <div class="admin-main">
        {% include 'partials/topbar.html.twig' %}

        <main class="admin-content">
                    {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="dash-alert dash-alert-{{ type }}">
                        <i class="fa-solid fa-circle-check"></i> {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% include 'partials/footer.html.twig' %}
    </div>
</div>

{% block javascripts %}{% endblock %}
</body>
</html>