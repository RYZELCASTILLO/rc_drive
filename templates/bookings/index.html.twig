{% extends 'base.html.twig' %}

{% block title %}Bookings{% endblock %}

{% block body %}

<div class="dash-page-title">
    <h2>Rental <span>Bookings</span></h2>
    <p>Approve or reject requests, hand over cars, and process returns and cancellations.</p>
</div>

<div class="dash-alert dash-alert-info">
    <i class="fa-solid fa-circle-info"></i>
    Demo mode: the buttons show a message, but nothing is saved until the database is connected.
</div>

<div class="dash-tabs">
    <a href="{{ path('app_bookings') }}" class="dash-tab {{ filter == 'All' ? 'active' : '' }}">All <span class="count">{{ total }}</span></a>
    {% for status, count in counts %}
        <a href="{{ path('app_bookings', {status: status}) }}" class="dash-tab {{ filter == status ? 'active' : '' }}">{{ status }} <span class="count">{{ count }}</span></a>
    {% endfor %}
</div>

<div class="dash-section">
    <div class="dash-table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Dates</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for b in bookings %}
                    <tr>
                        <td>{{ b.id }}</td>
                        <td>
                            <span class="dash-vehicle-name">{{ b.customer }}</span>
                            <span class="cell-sub">{{ b.phone }}</span>
                            {% if b.note %}<span class="cell-sub">{{ b.note }}</span>{% endif %}
                        </td>
                        <td>{{ b.vehicle }}</td>
                        <td>{{ b.pickup }}<span class="cell-sub">to {{ b.return }}</span></td>
                        <td class="dash-money">₱{{ b.total|number_format(2) }}</td>
                        <td><span class="dash-badge {{ b.pay_badge }}">{{ b.payment_status }}</span></td>
                        <td><span class="dash-badge {{ b.badge }}">{{ b.status }}</span></td>
                        <td>
                            <div class="action-group">
                                {% if b.status == 'Pending' %}
                                    <form method="post" action="{{ path('app_bookings_action', {id: b.id, action: 'approve'}) }}">
                                        <button type="submit" class="dash-btn dash-btn-green dash-btn-sm">Approve</button>
                                    </form>
                                    <form method="post" action="{{ path('app_bookings_action', {id: b.id, action: 'reject'}) }}">
                                        <button type="submit" class="dash-btn dash-btn-danger dash-btn-sm">Reject</button>
                                    </form>
                                {% elseif b.status == 'Approved' %}
                                    <form method="post" action="{{ path('app_bookings_action', {id: b.id, action: 'pickup'}) }}">
                                        <button type="submit" class="dash-btn dash-btn-outline dash-btn-sm">Picked Up</button>
                                    </form>
                                    <form method="post" action="{{ path('app_bookings_action', {id: b.id, action: 'cancel'}) }}">
                                        <button type="submit" class="dash-btn dash-btn-danger dash-btn-sm">Cancel</button>
                                    </form>
                                {% elseif b.status == 'Picked Up' %}
                                    <form method="post" action="{{ path('app_bookings_action', {id: b.id, action: 'return'}) }}">
                                        <input type="number" name="days_late" min="0" placeholder="Days late" class="late-input">
                                        <button type="submit" class="dash-btn dash-btn-yellow dash-btn-sm">Return</button>
                                    </form>
                                {% elseif b.status == 'Cancel Requested' %}
                                    <form method="post" action="{{ path('app_bookings_action', {id: b.id, action: 'approve-cancel'}) }}">
                                        <button type="submit" class="dash-btn dash-btn-green dash-btn-sm">Approve</button>
                                    </form>
                                    <form method="post" action="{{ path('app_bookings_action', {id: b.id, action: 'decline-cancel'}) }}">
                                        <button type="submit" class="dash-btn dash-btn-danger dash-btn-sm">Decline</button>
                                    </form>
                                {% else %}
                                    <span class="cell-sub">No actions</span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr class="empty-row"><td colspan="8">No bookings found for this filter.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}