{% extends 'base.html.twig' %}

{% block title %}Payments{% endblock %}

{% block body %}

<div class="dash-page-title">
    <h2>Payment <span>Verification</span></h2>
    <p>Check payment references from customers and verify or reject them.</p>
</div>

<div class="dash-alert dash-alert-info">
    <i class="fa-solid fa-circle-info"></i>
   
</div>

<div class="dash-stats">
    <div class="dash-stat-card green">
        <span class="stat-label">Verified Payments</span>
        <div class="stat-value">₱{{ verified_total|number_format(0) }}</div>
        <span class="stat-sub">Paid + partial payments</span>
    </div>
    <div class="dash-stat-card blue">
        <span class="stat-label">Awaiting Verification</span>
        <div class="stat-value">{{ counts['Pending Verification'] }}</div>
        <span class="stat-sub">₱{{ awaiting_amount|number_format(0) }} to review</span>
    </div>
    <div class="dash-stat-card red">
        <span class="stat-label">Unpaid Bookings</span>
        <div class="stat-value">{{ counts['Unpaid'] }}</div>
        <span class="stat-sub">No payment yet</span>
    </div>
</div>

<div class="dash-tabs">
    <a href="{{ path('app_payments') }}" class="dash-tab {{ filter == 'All' ? 'active' : '' }}">All <span class="count">{{ total }}</span></a>
    {% for status, count in counts %}
        <a href="{{ path('app_payments', {status: status}) }}" class="dash-tab {{ filter == status ? 'active' : '' }}">{{ status }} <span class="count">{{ count }}</span></a>
    {% endfor %}
</div>

<div class="dash-section">
    <div class="dash-table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Booking</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Type</th>
                    <th>Reference No.</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for p in payments %}
                    <tr>
                        <td>#{{ p.booking_id }}</td>
                        <td>
                            <span class="dash-vehicle-name">{{ p.customer }}</span>
                            <span class="cell-sub">{{ p.vehicle }}</span>
                        </td>
                        <td>₱{{ p.total|number_format(2) }}</td>
                        <td class="dash-money">₱{{ p.paid|number_format(2) }}</td>
                        <td>₱{{ p.balance|number_format(2) }}</td>
                        <td>{{ p.type ?: '—' }}</td>
                        <td>{{ p.reference ?: '—' }}</td>
                        <td><span class="dash-badge {{ p.badge }}">{{ p.status }}</span></td>
                        <td>
                            <div class="action-group">
                                {% if p.status == 'Pending Verification' %}
                                    <form method="post" action="{{ path('app_payments_action', {id: p.booking_id, action: 'verify'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('payment_booking_' ~ p.booking_id) }}">
                                    <button type="submit" class="dash-btn dash-btn-green dash-btn-sm">Verify</button>
                                </form>
                                <form method="post" action="{{ path('app_payments_action', {id: p.booking_id, action: 'reject'}) }}"
                                      onsubmit="return confirm('Reject this payment? The customer must pay again.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('payment_booking_' ~ p.booking_id) }}">
                                    <button type="submit" class="dash-btn dash-btn-danger dash-btn-sm">Reject</button>
                                </form>
                                {% else %}
                                    <span class="cell-sub">No actions</span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr class="empty-row"><td colspan="9">No payments found for this filter.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}