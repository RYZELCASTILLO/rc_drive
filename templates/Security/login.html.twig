{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="auth-card">
    <img src="{{ asset('images/logo.png') }}" alt="RC Drive Logo">
    <h2>Sign in</h2>
    <p>Use your admin or staff account.</p>

    {% if error %}
        <div class="dash-alert dash-alert-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post">
        <div class="form-group">
            <label for="username">Email</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" class="form-input" required autofocus autocomplete="email">
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="_password" class="form-input" required autocomplete="current-password">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="dash-btn dash-btn-yellow dash-btn-block">
            <i class="fa-solid fa-right-to-bracket"></i> Login
        </button>
    </form>
</div>
{% endblock %}