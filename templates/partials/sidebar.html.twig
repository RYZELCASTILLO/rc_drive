{% set current_route = app.request.attributes.get('_route') %}

<aside class="sidebar">
    <div class="sidebar-logo">
        <img src="{{ asset('images/logo.png') }}" alt="RC Drive Logo">
    </div>

    <nav class="sidebar-nav">
        {% if is_granted('ROLE_ADMIN') %}
            <span class="sidebar-label">Admin</span>
            <a href="{{ path('app_dashboard') }}" class="{{ current_route == 'app_dashboard' ? 'active' : '' }}">
                <i class="fa-solid fa-gauge-high"></i> <span class="link-text">Dashboard</span>
            </a>
            <a href="{{ path('app_users') }}" class="{{ current_route starts with 'app_users' ? 'active' : '' }}">
                <i class="fa-solid fa-users"></i> <span class="link-text">Users</span>
            </a>
        {% endif %}

        <span class="sidebar-label">Manage</span>
        <a href="{{ path('app_bookings') }}" class="{{ current_route starts with 'app_bookings' ? 'active' : '' }}">
            <i class="fa-solid fa-car-side"></i> <span class="link-text">Bookings</span>
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_payments') }}" class="{{ current_route == 'app_payments' ? 'active' : '' }}">
                <i class="fa-solid fa-money-bill-wave"></i> <span class="link-text">Payments</span>
            </a>
            <a href="{{ path('app_fleet') }}" class="{{ current_route == 'app_fleet' ? 'active' : '' }}">
                <i class="fa-solid fa-warehouse"></i> <span class="link-text">Fleet</span>
            </a>
            <a href="{{ path('app_conversations') }}" class="{{ current_route == 'app_conversations' ? 'active' : '' }}">
                <i class="fa-solid fa-comments"></i> <span class="link-text">Conversations</span>
            </a>
        {% endif %}

        <span class="sidebar-label">Account</span>
        <a href="{{ path('app_profile') }}" class="{{ current_route starts with 'app_profile' ? 'active' : '' }}">
            <i class="fa-solid fa-user"></i> <span class="link-text">My Profile</span>
        </a>
    </nav>

    <div class="sidebar-bottom">
        <i class="fa-solid fa-circle-user"></i> <span class="link-text">{{ app.user.name }}</span>
    </div>
</aside>